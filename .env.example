# 서버 포트
PORT=3000

# Higgsfield API (Higgsfield 계정에서 발급한 API Key / Secret)
# 둘 중 한 가지 방식으로 지정
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# HF_KEY=키:시크릿

# (선택) 사용할 이미지 편집 모델과 이미지 입력 필드 이름
# HIGGSFIELD_MODEL=bytedance/seedream/v4/edit
# HIGGSFIELD_IMAGE_FIELD=image_urls
# HIGGSFIELD_PROMPT=...
# HIGGSFIELD_BASE_URL=https://api.higgsfield.ai
# HIGGSFIELD_TIMEOUT_MS=180000
